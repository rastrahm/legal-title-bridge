.anchor/
test-ledger/
.cargo-cache/

# Artefactos de programa (regenerables con anchor build)
solana/target/deploy/*.so
# Mantener keypairs de programa solo si el equipo decide versionarlos;
# por defecto NO versionar keypairs reales:
solana/target/deploy/*-keypair.json
*.so

