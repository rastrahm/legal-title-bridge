# Foundry (Ethereum)
# -----------------------------------------------------------------------------
cache/
out/
broadcast/
/lib/

# Cobertura y reportes Foundry
lcov.info
coverage/
gas-report.txt
# Versionar .gas-snapshot (C13: forge snapshot --check)
