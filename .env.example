# Legal Title Bridge — variables de entorno (sin secretos reales)
# Copia a .env y rellena. Nunca commits .env.

# Ethereum
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
MAINNET_RPC_URL=
ANVIL_RPC_URL=http://127.0.0.1:8545

# Solana
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_LOCAL_RPC_URL=http://127.0.0.1:8899

# Relayers (solo rutas / paths — las claves van fuera del repo)
RELAYER_KEYS_DIR=./secrets/relayers
RELAYER_STATUS_PORT_1=3101
RELAYER_STATUS_PORT_2=3102
RELAYER_STATUS_PORT_3=3103

# Frontend (públicas; direcciones de contratos salen de shared/, no de aquí)
NEXT_PUBLIC_NETWORK=local
NEXT_PUBLIC_E2E=0
NEXT_PUBLIC_RELAYER_STATUS_URL=http://127.0.0.1:3101

# Confirmaciones del watcher Ethereum (lab)
ETH_CONFIRMATIONS=2
